BOT_TOKEN=
# Используйте GPT-oSS-20b или другую модель HuggingFace
# Пример: HF_MODEL=Qwen/Qwen2.5-7B-Instruct или HF_MODEL=GPT-oSS-20b (если доступна)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TOKEN=your_huggingface_token

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=misis_bot_vectors

# Generation settings
MAX_NEW_TOKENS=512
TEMPERATURE=0.7